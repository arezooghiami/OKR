# --- Running the API on this machine (uvicorn) ---------------------------------------------------
OKR_DATABASE_URL=postgresql+psycopg://okr:okr_dev_password@localhost:5433/okr
OKR_SECRET_KEY=change-me-in-production
OKR_CORS_ORIGINS=["http://localhost:5173"]
OKR_ACCESS_TOKEN_MINUTES=15
OKR_REFRESH_TOKEN_DAYS=14
OKR_TIMEZONE=Asia/Tehran

# --- docker compose (backend/docker-compose.yml) also reads these ------------------------------
# OKR_DB_PASSWORD=okr_dev_password      # set before the FIRST start; the database keeps it afterwards
# OKR_DB_NAME=okr                       # e.g. okr_pm_demo for the demo organisation
# OKR_DB_PORT=5433                      # database port published on this machine
# OKR_WEB_PORT=8088                     # the app: http://localhost:8088
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/   # when pypi.org is blocked
# NPM_REGISTRY=https://registry.npmmirror.com             # when registry.npmjs.org is blocked
